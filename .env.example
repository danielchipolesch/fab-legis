# ── Perfil do ambiente ────────────────────────────────────────────────────────
# Quais serviços sobem com `docker compose up -d`. dev = frontend de desenvolvimento (Vite com recarga); production = o
# frontend compilado atrás do Nginx (nginx/nginx.conf). Em produção troque para: COMPOSE_PROFILES=production
COMPOSE_PROFILES=dev

# Em que interface o Docker publica estas portas. 127.0.0.1 = só a própria máquina (padrão, seguro). Em PRODUÇÃO:
#  - MINIO_BIND: com o MinIO atrás do Nginx (README, passo 1 -- recomendado) fica 127.0.0.1; 0.0.0.0 só se o navegador for chegar a ele direto.
# MINIO_BIND=127.0.0.1

# Variáveis de ambiente do FAB Legis — arquivo único para as duas formas de
# rodar o projeto:
#   1. docker-compose.yml lê este .env da raiz para resolver os ${VAR:-padrão}
#      de cada serviço (ver "Caminho A" no README.md).
#   2. `npm run dev`/`npm run build` do frontend fora do Docker também leem
#      este mesmo arquivo -- ver `envDir` em frontend/vite.config.js (Caminho B
#      no README.md). Não existe mais um .env.example separado
#      dentro de frontend/.
#
# Copie este arquivo para `.env` (mesma pasta) e ajuste o que precisar — o
# `.env` real fica de fora do git (ver .gitignore). Todo valor aqui já é o
# fallback usado pelo próprio docker-compose.yml quando a variável não está
# definida, então rodar `docker compose up` SEM nenhum `.env` continua
# funcionando exatamente como hoje: os valores abaixo são só a documentação
# desse comportamento padrão de desenvolvimento, não segredos reais.
#
# Em produção, nunca reaproveite estes valores — troque todos, principalmente
# as senhas de banco/MinIO/administrador.

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123456
POSTGRES_DB=fab-legis-dev

# ── MinIO (armazenamento de imagens/PDFs) ────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_BUCKET=fab-legis-imagens

# ── Backend Spring Boot — Authorization Server (OAuth2 + PKCE) ────────────────
# issuer precisa ser o endereço que o NAVEGADOR usa (vira o claim "iss" de todo
# token emitido) -- backend, collab (validação via JWKS) e frontend (URL de
# /oauth2/authorize) todos precisam concordar nesse mesmo valor. Usa 127.0.0.1
# (não localhost) de propósito -- mesma convenção de VITE_API_BASE_URL/
# VITE_OAUTH2_BASE_URL abaixo. localhost e 127.0.0.1 são origens DIFERENTES
# pro navegador (cookie de sessão/sessionStorage não atravessam) -- misturar
# os dois faz o fluxo de login quebrar de forma pouco óbvia (cai numa página
# em branco/JSON de erro no meio do caminho). Se mudar um, mude o outro junto.
APP_OAUTH2_ISSUER=http://127.0.0.1:8081
# Rota de callback da SPA (troca o code por token) e URL da tela de login (Vue)
# -- pra onde o Authorization Server redireciona usuários não-autenticados.
APP_OAUTH2_REDIRECT_URI=http://127.0.0.1:5173/callback
APP_FRONTEND_LOGIN_URL=http://127.0.0.1:5173/login

# Usuário administrador padrão, criado pelo DataSeeder no primeiro boot (só se
# nenhum usuário com login ainda existir).
APP_ADMIN_CPF=11144477735
APP_ADMIN_SENHA=Admin@123
APP_ADMIN_NOME=DANIEL ANGELO CHIPOLESCH DE ALMEIDA
APP_ADMIN_NOME_GUERRA=CHIPOLESCH
APP_ADMIN_EMAIL=chipoleschdaca@fab.mil.br
APP_ADMIN_POSTO=CP

# Geração de PDF (Apache FOP): renderizações simultâneas por instância e quanto um pedido
# espera por uma vaga antes de receber 503 -- ver docs/exportacao-pdf.md.
APP_PDF_MAX_CONCORRENTES=2
APP_PDF_ESPERA_MAXIMA_SEGUNDOS=30

# Cache do PDF/HTML em tramitação no MinIO: dias até o MinIO expirar o cache (ver docs/exportacao-pdf.md).
APP_PDF_CACHE_TTL_DIAS=2

# ── Frontend (Vite) ───────────────────────────────────────────────────────────
# VITE_* só chega ao bundle/dev-server (nunca ao backend) -- ver frontend/vite.config.js.
VITE_USE_MOCK_API=false
VITE_API_BASE_URL=http://127.0.0.1:8081/v1
VITE_COLLAB_URL=ws://127.0.0.1:1234
# NÃO é VITE_* de propósito: só o processo do Vite (lado servidor, dentro do
# container) usa isto pra saber pra onde proxiar /oauth2/**, /login, /logout
# (ver server.proxy em vite.config.js) -- nunca chega ao bundle do navegador.
# O navegador nunca vê esse endereço: ele sempre fala com o PRÓPRIO frontend
# (caminho relativo), que repassa a chamada por trás. Isso é o que faz login/
# logout funcionarem de forma confiável -- sem o proxy, era uma chamada
# cross-origin de verdade pro backend, e o cookie de sessão do Spring
# Security (SameSite=Lax) não sobrevive a isso de forma consistente (some em
# alguns casos, "funciona" às vezes dependendo de quanto tempo passa entre
# abrir a página e submeter o formulário) -- um bug intermitente e difícil de
# perceber sem essa explicação.
PROXY_BACKEND_TARGET=http://127.0.0.1:8081
# Ambiente (development | staging | production) -- só troca o comportamento de
# build (sourcemap em 'staging', ver vite.config.js); Docker sempre usa 'development'.
VITE_APP_ENV=development
# Exibida em logs/telas de diagnóstico; não afeta build. Atualize a cada release.
VITE_APP_VERSION=1.0.0

# ── Nginx do frontend de produção (perfil "production") ───────────────────────
# O Nginx tem a SUA configuração por ambiente: nginx/nginx.conf (fora do git), copiada de nginx/nginx.conf.example -- como
# este .env. Não há variável para ele; o que muda por ambiente (hosts do backend/collab, TLS) é editado naquele arquivo.
#
# Para exercitar LOCALMENTE o mesmo caminho de produção (Nginx na porta 80, tudo na mesma origem), troque os valores acima
# das seções do backend e do frontend por estes e suba `docker compose --profile production up -d --build`:
#   APP_OAUTH2_ISSUER=http://127.0.0.1
#   APP_OAUTH2_REDIRECT_URI=http://127.0.0.1/callback
#   APP_FRONTEND_LOGIN_URL=http://127.0.0.1/login
#   VITE_API_BASE_URL=http://127.0.0.1/v1
#   VITE_COLLAB_URL=ws://127.0.0.1/collab
# Em produção de verdade é a mesma coisa com o domínio público e https/wss (ver "Instalação em produção" no README.md).

# ── Backend: opcionais ────────────────────────────────────────────────────────
# Publica a Swagger UI (/swagger-ui.html) e o JSON do OpenAPI (/v1/fab-legis-api). Os endpoints exigem token de qualquer jeito.
# APP_SWAGGER_ENABLED=true
# Origens do navegador autorizadas a chamar a API (CORS), separadas por vírgula. O padrão é o frontend de desenvolvimento.
# EM PRODUÇÃO (tudo atrás do Nginx, mesma origem) deixe vazio: APP_CORS_ALLOWED_ORIGINS=
# APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ── Chave de assinatura dos tokens (README, passo 4) ──────────────────────────
# O backend usa segredos/jwt/jwt-rsa.pem (pasta do servidor, fora do git) se ela existir; senão, uma chave efêmera (cada restart
# derruba as sessões). EM PRODUÇÃO: gere o arquivo e ligue a trava, para o backend nunca subir sem a chave persistente:
# APP_OAUTH2_CHAVE_OBRIGATORIA=true
# Outra pasta para a chave (padrão ./segredos/jwt):
# CHAVES_JWT=./segredos/jwt
