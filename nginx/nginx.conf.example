# Nginx da borda do sistema -- versão HTTP (desenvolvimento local do perfil "production", ou atrás de um balanceador/proxy que já
# termina o TLS). Copie para nginx/nginx.conf (fora do git). Para HTTPS direto no Nginx use nginx.https.conf.example.
# Tudo que é comum (SPA, proxy reverso para o backend e o collab) está em comum.conf.

# Reforço de segurança dos arquivos do armazenamento (ver o `server` do nome do armazenamento, abaixo): tudo vai com `sandbox`, menos os
# tipos que o navegador só exibe (imagens e PDF). Precisa ficar aqui, fora do `server` (um `map` só existe no nível do http).
map $upstream_http_content_type $csp_do_armazenamento {
    default                             "default-src 'none'; sandbox";
    "~*^image/(png|jpeg|gif|webp)(;|$)" "";
    "~*^application/pdf(;|$)"           "";
}


server {
    listen 8080;
    server_name _;

    include /etc/nginx/comum.conf;
}

# Arquivos do armazenamento de objetos, com NOME próprio (outra origem, de propósito): usado quando o TLS termina ANTES (balanceador/Ingress),
# que manda este nome para cá. Veja o bloco equivalente, com HTTPS, em nginx.https.conf.example (e o porquê do nome separado).
server {
    listen 8080;
    server_name s3.exemplo.intraer;

    location / {
        limit_except GET HEAD { deny all; }
        proxy_pass http://armazenamento:9000;
        # A assinatura das URLs inclui o Host: tem de chegar ao armazenamento exatamente como o navegador o enviou.
        proxy_set_header Host   $http_host;
        proxy_set_header Cookie "";
        proxy_buffering off;
        add_header Content-Security-Policy $csp_do_armazenamento always;
        add_header X-Content-Type-Options  nosniff always;
    }
}
