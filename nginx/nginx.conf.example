server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # ── Compressão ────────────────────────────────────────────
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/javascript
        application/javascript
        application/json
        application/xml
        application/xml+rss
        image/svg+xml
        font/woff
        font/woff2;

    # ── Segurança — cabeçalhos HTTP ───────────────────────────
    add_header X-Frame-Options            "SAMEORIGIN"                      always;
    add_header X-Content-Type-Options     "nosniff"                         always;
    add_header X-XSS-Protection           "1; mode=block"                   always;
    add_header Referrer-Policy            "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy         "geolocation=(), microphone=()"   always;

    # ── Cache — ativos com hash (Vite gera nomes únicos) ─────
    location ~* \.(js|css|woff2?|ttf|eot|otf)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    location ~* \.(png|jpg|jpeg|gif|ico|svg|webp)$ {
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    # ── index.html — nunca cacheado (SPA entry point) ────────
    location = /index.html {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma        "no-cache";
        add_header Expires       "0";
    }

    # ── Probe de saúde ────────────────────────────────────────
    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    # ── Documentação técnica em /docs/ (mesmo host do sistema: fab-legis.intraer/docs) ──
    # O site do MkDocs é compilado na própria imagem (estágio docs-build do frontend/Dockerfile) e fica em /docs. `^~` para não
    # cair no bloco de cache imutável de .js/.css acima (os assets do MkDocs não têm hash no nome).
    location = /docs {
        return 301 /docs/;
    }

    location ^~ /docs/ {
        expires 1h;
        try_files $uri $uri/ =404;
    }

    # ── Proxy reverso — mesma origem para o navegador ─────────
    # É o equivalente de produção do `server.proxy` do Vite (vite.config.js): /oauth2/**, /login (POST), /logout,
    # /.well-known/** e /v1/** parecem, para o navegador, a mesma origem do frontend -- o que faz o cookie de sessão
    # (SameSite=Lax) sobreviver ao login OAuth2. Os nomes `backend:8081` e `collab:1234` são os serviços da rede do Compose;
    # este arquivo (nginx.conf, fora do git) é por ambiente -- copie de nginx.conf.example e ajuste o que o ambiente exigir.
    # O Host NÃO é reescrito: o Spring Security o usa para montar URLs de redirect.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    location ~ ^/(oauth2|logout|\.well-known)(/|$) {
        proxy_pass http://backend:8081;
    }

    location ^~ /v1/ {
        proxy_pass http://backend:8081;
    }

    # Swagger UI: o contrato da API para quem vai consumi-la. Os endpoints seguem exigindo token (o Swagger só descreve);
    # APP_SWAGGER_ENABLED=false no backend desliga a UI e o JSON (o /v1/fab-legis-api do bloco acima). `^~` e `=` para não
    # caírem no bloco de cache de .js/.css, que serviria 404 para os assets do Swagger.
    location ^~ /swagger-ui/ {
        proxy_pass http://backend:8081;
    }

    location = /swagger-ui.html {
        proxy_pass http://backend:8081;
    }

    # GET /login é a tela de login da SPA (Vue Router); só o POST é do backend. O 418 é o truque usual do nginx para
    # decidir por método: o POST cai no @backend, o resto serve a SPA.
    location = /login {
        error_page 418 = @backend;
        if ($request_method = POST) { return 418; }
        try_files /index.html =404;
    }

    location @backend {
        proxy_pass http://backend:8081;
    }

    # Colaboração em tempo real (Hocuspocus/Yjs): WebSocket em /collab. A barra final tira o prefixo antes de repassar.
    location ^~ /collab/ {
        proxy_pass http://collab:1234/;
        proxy_http_version 1.1;
        # Quem declara algum proxy_set_header no bloco não herda os do server: repete os comuns.
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # ── SPA — redireciona tudo para index.html ────────────────
    location / {
        try_files $uri $uri/ /index.html;
    }

    server_tokens off;
    client_max_body_size 10m;
}
