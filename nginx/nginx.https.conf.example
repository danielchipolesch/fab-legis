# Nginx da borda do sistema -- versão HTTPS (produção com TLS terminado aqui). Copie para nginx/nginx.conf (fora do git) e coloque
# o certificado em segredos/tls/ (fora do git): fullchain.pem (certificado + intermediárias) e privkey.pem (chave privada).
# O docker-compose.yml publica 80 -> 8080 e 443 -> 8443. Tudo que é comum está em comum.conf.

# Reforço de segurança dos arquivos do armazenamento (ver o `server` do nome do armazenamento, abaixo): tudo vai com `sandbox`, menos os
# tipos que o navegador só exibe (imagens e PDF). Precisa ficar aqui, fora do `server` (um `map` só existe no nível do http).
map $upstream_http_content_type $csp_storage {
    default                             "default-src 'none'; sandbox";
    "~*^image/(png|jpeg|gif|webp)(;|$)" "";
    "~*^application/pdf(;|$)"           "";
}



# HTTP: só redireciona para HTTPS (e responde o /health que o healthcheck do container usa).
server {
    listen 8080;
    server_name _;

    location = /health {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS
server {
    listen 8443 ssl;
    http2 on;
    server_name _;     # troque pelo nome do host, ex.: fab-legis.intraer

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    # Diz ao navegador para usar sempre HTTPS neste host (1 ano).
    add_header Strict-Transport-Security "max-age=31536000" always;

    include /etc/nginx/comum.conf;
}

# Arquivos do armazenamento de objetos (SeaweedFS), com NOME e HTTPS próprios -- outra origem, de propósito. O navegador baixa as imagens
# direto dele por URLs assinadas (STORAGE_PUBLIC_URL=https://<este nome>); numa página HTTPS essas URLs também têm de ser HTTPS
# (senão o navegador bloqueia: conteúdo misto). O TLS fica aqui, no mesmo Nginx e com o mesmo certificado (que precisa cobrir os DOIS
# nomes: SAN com os dois, ou curinga), e o armazenamento segue em HTTP, só na rede interna (por isso a porta 9000 não precisa ser publicada).
# Troque server_name pelo nome real e use STORAGE_PUBLIC_URL=https://<esse nome> no .env.
#
# Por que um nome SEPARADO: a API de imagens aceita qualquer arquivo, e um HTML/SVG com script aberto na MESMA origem do sistema leria o
# token do localStorage (testado). Em outra origem o script não alcança o sistema. Reforço: tudo que não é imagem nem PDF sai com
# `Content-Security-Policy: sandbox` ($csp_storage, o `map` do topo deste arquivo) e `nosniff`.
server {
    listen 8443 ssl;
    http2 on;
    server_name s3.exemplo.intraer;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;

    location / {
        limit_except GET HEAD { deny all; }
        proxy_pass http://storage:9000;
        # A assinatura das URLs inclui o Host: tem de chegar ao armazenamento exatamente como o navegador o enviou.
        proxy_set_header Host   $http_host;
        proxy_set_header Cookie "";
        proxy_buffering off;
        add_header Content-Security-Policy   $csp_storage always;
        add_header X-Content-Type-Options    nosniff always;
        add_header Strict-Transport-Security "max-age=31536000" always;
    }
}
